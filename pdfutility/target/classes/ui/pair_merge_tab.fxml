<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="olivieri.alex.fx.tab.FxPairMergeTabContentController">
  <center>
    <GridPane hgap="10" vgap="10">
      <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
      </padding>
      <Label text="Cartella 1:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="pairFirstField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      <Button fx:id="pairFirstBrowse" text="Cartella 1" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <Label text="Cartella 2:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextField fx:id="pairSecondField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
      <Button fx:id="pairSecondBrowse" text="Cartella 2" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
      <CheckBox fx:id="normalizePairCheck" text="Normalizza F/R (aggiungi pagina bianca se dispari)" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
    </GridPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10">
      <padding>
        <Insets bottom="10" left="10" right="12" top="8"/>
      </padding>
      <ProgressIndicator fx:id="pairProgress" maxHeight="24" maxWidth="24" visible="false"/>
      <Button fx:id="pairMergeButton" text="Unisci"/>
    </HBox>
  </bottom>
</BorderPane>
