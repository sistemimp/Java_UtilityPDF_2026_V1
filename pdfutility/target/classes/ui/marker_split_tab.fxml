<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="olivieri.alex.fx.tab.FxMarkerSplitTabContentController">
  <center>
    <GridPane hgap="10" vgap="10">
      <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
      </padding>
      <Label text="PDF sorgente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="markerPdfField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      <Button fx:id="markerPdfBrowse" text="Seleziona PDF" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <Label text="Stringa marker:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextField fx:id="markerTextField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1"/>
      <CheckBox fx:id="markerCaseSensitive" text="Rispetta maiuscole/minuscole" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
      <Label text="Cartella base:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
      <TextField fx:id="markerBaseField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
      <Button fx:id="markerBaseBrowse" text="Cartella base" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
      <Label text="Nome cartella risultati:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
      <TextField fx:id="markerFolderField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="4"/>
      <CheckBox fx:id="markerAppendCheck" text="Aggiungi pagine se esiste" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="5"/>
    </GridPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10">
      <padding>
        <Insets bottom="10" left="10" right="12" top="8"/>
      </padding>
      <ProgressIndicator fx:id="markerProgress" maxHeight="24" maxWidth="24" visible="false"/>
      <Button fx:id="markerButton" text="Esegui split"/>
    </HBox>
  </bottom>
</BorderPane>
