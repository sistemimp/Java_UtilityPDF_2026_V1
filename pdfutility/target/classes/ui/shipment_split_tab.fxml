<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="olivieri.alex.fx.tab.FxShipmentSplitTabContentController">
  <center>
    <GridPane hgap="10" vgap="10">
      <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
      </padding>
      <Label text="PDF sorgente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="shipmentPdfField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      <Button fx:id="shipmentPdfBrowse" text="Seleziona PDF" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <Label text="Stringa marker invio:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextField fx:id="shipmentMarkerField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1"/>
      <CheckBox fx:id="shipmentCaseSensitive" text="Rispetta maiuscole/minuscole" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
      <Label text="Invii per file:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
      <Spinner fx:id="shipmentCountSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
      <Label text="Cartella base:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
      <TextField fx:id="shipmentBaseField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
      <Button fx:id="shipmentBaseBrowse" text="Cartella base" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
      <Label text="Nome cartella risultati:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
      <TextField fx:id="shipmentFolderField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="5"/>
      <Label text="Prefisso file output:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
      <TextField fx:id="shipmentPrefixField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="6"/>
    </GridPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10">
      <padding>
        <Insets bottom="10" left="10" right="12" top="8"/>
      </padding>
      <ProgressIndicator fx:id="shipmentProgress" maxHeight="24" maxWidth="24" visible="false"/>
      <Button fx:id="shipmentButton" text="Esegui split per invii"/>
    </HBox>
  </bottom>
</BorderPane>
