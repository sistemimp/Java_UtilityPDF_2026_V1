<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="olivieri.alex.fx.tab.FxRepeatTabContentController">
  <center>
    <GridPane hgap="10" vgap="10">
      <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
      </padding>
      <Label text="PDF sorgente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="repeatInputField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Button fx:id="repeatBrowseButton" text="Seleziona PDF" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <Label text="Ripetizioni:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <Spinner fx:id="repeatSpinner" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
      <Label text="File di output:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="repeatOutputField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
      <Label prefHeight="123.0" prefWidth="334.0" text="Il programma consente di generare un nuovo documento PDF a partire da un file sorgente, inserendo automaticamente una pagina bianca dopo ogni pagina del PDF originale. Una volta selezionato il documento di origine, il software elabora il contenuto e crea un PDF risultante in cui ogni pagina del file sorgente è seguita da una pagina vuota." textAlignment="CENTER" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.halignment="CENTER" GridPane.rowIndex="3" GridPane.valignment="TOP" />
         <columnConstraints>
            <ColumnConstraints percentWidth="15.0" />
            <ColumnConstraints percentWidth="70.0" />
            <ColumnConstraints percentWidth="20.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
    </GridPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" prefHeight="42.0" prefWidth="749.0" spacing="10">
      <padding>
        <Insets bottom="10" left="10" right="12" top="8" />
      </padding>
      <ProgressIndicator fx:id="repeatProgress" maxHeight="24" maxWidth="24" visible="false" />
      <Button fx:id="repeatButton" text="Ripeti PDF" />
    </HBox>
  </bottom>
</BorderPane>
