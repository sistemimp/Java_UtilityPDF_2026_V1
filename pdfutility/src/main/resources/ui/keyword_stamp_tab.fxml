<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="olivieri.alex.fx.tab.FxKeywordStampTabContentController">
  <center>
    <GridPane hgap="10" vgap="10">
      <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
      </padding>
      <Label text="PDF sorgente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="keywordStampInputField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      <Button fx:id="keywordStampBrowseInput" text="PDF" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <Label text="Parola chiave:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextField fx:id="keywordStampKeywordField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1"/>
      <Label text="Testo timbro:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
      <TextField fx:id="keywordStampTextField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2"/>
      <Label text="File di output:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
      <TextField fx:id="keywordStampOutputField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
      <Button fx:id="keywordStampBrowseOutput" text="Output" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
      <CheckBox fx:id="keywordStampCaseSensitive" text="Rispetta maiuscole/minuscole" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="4"/>
      <Label text="Coordinata X:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
      <Spinner fx:id="keywordStampXSpinner" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
      <Label text="Coordinata Y:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
      <Spinner fx:id="keywordStampYSpinner" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    </GridPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10">
      <padding>
        <Insets bottom="10" left="10" right="12" top="8"/>
      </padding>
      <ProgressIndicator fx:id="keywordStampProgress" maxHeight="24" maxWidth="24" visible="false"/>
      <Button fx:id="keywordStampButton" text="Applica timbro"/>
    </HBox>
  </bottom>
</BorderPane>
